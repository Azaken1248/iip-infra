POSTGRES_PASSWORD=iip

# Origins allowed to call source-service's API (comma-separated, no spaces).
# Defaults cover local dev only — set this to your deployed UI's real
# origin(s) (e.g. https://your-app.vercel.app) for a hosted deployment.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Host-side ports only — containers always reach each other via their
# service name and internal port (e.g. postgres:5432, kafka:19092).
# Defaults below are chosen to reduce collisions with locally-installed
# services; override any of them if they still collide on your machine.
POSTGRES_HOST_PORT=5433
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8090
SOURCE_SERVICE_HOST_PORT=8080
DB_ADAPTER_HOST_PORT=8081
FILE_ADAPTER_HOST_PORT=8082
UI_HOST_PORT=3000
