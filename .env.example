POSTGRES_PASSWORD=iip

# Origins allowed to call source-service's, db-adapter's, and file-adapter's
# APIs (comma-separated, no spaces) — all three read this same var. Defaults
# cover local dev only — set this to your deployed UI's real origin(s)
# (e.g. https://iip.azaken.com) for a hosted deployment.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Host-side ports only — containers always reach each other via their
# service name and internal port (e.g. postgres:5432, kafka:19092).
# Defaults below are chosen to reduce collisions with locally-installed
# services; override any of them if they still collide on your machine.
POSTGRES_HOST_PORT=5433
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8090
SOURCE_SERVICE_HOST_PORT=8080
DB_ADAPTER_HOST_PORT=8081
FILE_ADAPTER_HOST_PORT=8082
CONTRACT_REGISTRY_HOST_PORT=8083
# 8085, not 8081: the db-adapter already owns 8081 on the host. Inside the
# network the Schema Registry stays on its conventional 8081.
SCHEMA_REGISTRY_HOST_PORT=8085
UI_HOST_PORT=3000

# How long a contract registered through the control plane takes to go live
# in the source-service (Release 4 Phase 4.4). Lower it to make "define a
# schema, then use it" feel immediate during a demo; raise it if many pods
# are polling one registry.
CONTRACT_REFRESH_INTERVAL_MS=30000

# Retry/backoff, independently tunable per adapter (Release 2 Phase 2.5) —
# deliberately separate var names, not one shared RETRY_* name, since a
# single shared name couldn't hold two different values for the two
# adapters at once. Defaults below match each adapter's own
# application.yml fallback.
DB_ADAPTER_RETRY_MAX_ATTEMPTS=3
DB_ADAPTER_RETRY_INITIAL_BACKOFF_MS=200
DB_ADAPTER_RETRY_MULTIPLIER=2.0
FILE_ADAPTER_RETRY_MAX_ATTEMPTS=3
FILE_ADAPTER_RETRY_INITIAL_BACKOFF_MS=200
FILE_ADAPTER_RETRY_MULTIPLIER=2.0
